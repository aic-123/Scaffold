# .gitattributes 管得住 git，管不住编辑器——这一半由本文件负责。
# 仓库现状：全 LF、无 BOM、零尾随空格、所有文件末尾有换行，
# 所以下面这份严格配置不会造成整文件 diff。

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
indent_style = space
indent_size = 2

[*.{py,yaml,yml}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
